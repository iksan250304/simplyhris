generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  HRD
  EMPLOYEE
}

enum DispensationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                String       @id @default(uuid())
  name              String
  email             String       @unique
  password          String
  role              Role         @default(EMPLOYEE)
  nik               String?      @unique
  ktpPhotoUrl       String?
  faceEmbedding     Json?
  baseSalary        Decimal?     @db.Decimal(12, 2)
  allowance         Decimal?     @db.Decimal(12, 2)
  bpjsPercent       Decimal?     @db.Decimal(5, 2)
  taxPercent        Decimal?     @db.Decimal(5, 2)
  officeLocationId  String?
  officeLocation    OfficeLocation? @relation(fields: [officeLocationId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  attendances       Attendance[]
  payrolls          Payroll[]
}

model OfficeLocation {
  id        String   @id @default(uuid())
  name      String
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  radius    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
}

model WorkSchedule {
  id        String   @id @default(uuid())
  month     Int
  year      Int
  checkIn   String
  checkOut  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
}

model Attendance {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id])
  date               DateTime
  checkInTime        DateTime?
  checkOutTime       DateTime?
  checkInLat         Decimal?           @db.Decimal(10, 7)
  checkInLng         Decimal?           @db.Decimal(10, 7)
  selfieUrl          String?
  faceSimilarity     Decimal?           @db.Decimal(5, 2)
  isLate             Boolean            @default(false)
  lateMinutes        Int                @default(0)
  dispensationStatus DispensationStatus @default(NONE)
  dispensationReason String?
  dispensationProof  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([userId, date])
}

model PayrollPeriod {
  id        String    @id @default(uuid())
  month     Int
  year      Int
  isLocked  Boolean   @default(false)
  createdAt DateTime  @default(now())

  payrolls  Payroll[]

  @@unique([month, year])
}

model Payroll {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  periodId       String
  period         PayrollPeriod @relation(fields: [periodId], references: [id])
  baseSalary     Decimal       @db.Decimal(12, 2)
  allowance      Decimal       @db.Decimal(12, 2)
  overtimePay    Decimal       @default(0) @db.Decimal(12, 2)
  taxDeduction   Decimal       @default(0) @db.Decimal(12, 2)
  bpjsDeduction  Decimal       @default(0) @db.Decimal(12, 2)
  lateDeduction  Decimal       @default(0) @db.Decimal(12, 2)
  totalDeduction Decimal       @default(0) @db.Decimal(12, 2)
  netSalary      Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())

  @@unique([userId, periodId])
}

model AppSetting {
  id                String   @id @default(uuid())
  lateFinePerMinute Decimal  @default(5000) @db.Decimal(12, 2)
  updatedAt         DateTime @updatedAt
}